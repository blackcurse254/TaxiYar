# GEMINI_API_KEY: Optional Gemini AI API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the deployment (auto-detected on Vercel/Render if unset).
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (e.g. postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require).
DATABASE_URL=

# LINK_SIGNING_SECRET: Server-side HMAC-SHA256 secret for typ=pay/drv/sms tokens and x-admin-secret header.
LINK_SIGNING_SECRET=

# WEBHOOK_HMAC_SECRET: Server-side HMAC-SHA256 secret for verifying bank SMS webhooks.
WEBHOOK_HMAC_SECRET=

# ACTIVE_GATEWAY: Set to "direct" for direct card-to-card mode (no external gateway keys are read).
ACTIVE_GATEWAY="direct"
